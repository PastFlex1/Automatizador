# GROQ_API_KEY: High-speed Llama 3.3 70B sales closing engine (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=""

# OPENAI_API_KEY: Required for ChatGPT / OpenAI API calls.
OPENAI_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META APP & OAUTH CONFIGURATION (Official Graph API / Threads API)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://metacloser-crm.ai.studio/api/social/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=""

# ACCESS CONTROL (required in production: without it the API refuses requests)
# APP_PASSWORD: password for the CRM login screen. Use a long one.
# APP_API_TOKEN: optional token for scripts/extension (header "Authorization: Bearer <token>").
# SESSION_SECRET: optional; changing it (or APP_PASSWORD) logs everyone out.
APP_PASSWORD=""
APP_API_TOKEN=""
SESSION_SECRET=""

# RUNTIME
# AUTOMATIONS_ENABLED=false turns off auto-replies, drips and auto-publishing on this machine.
# Set it to false on your PC once the server is online, or customers get double replies.
AUTOMATIONS_ENABLED="true"
# LOCAL MODE: port that exposes ONLY the Meta webhooks (point ngrok / Cloudflare Tunnel here,
# never to the CRM port). Requires META_APP_SECRET and META_WEBHOOK_VERIFY_TOKEN.
WEBHOOK_PORT="3100"
# Persistent storage for leads/settings and product photos (a volume on the server).
# Empty = src/data and public/equipos (local default).
DATA_DIR=""
UPLOADS_DIR=""

# WHATSAPP CLOUD API (official WhatsApp Business Platform)
# From developers.facebook.com > your app > WhatsApp > API Setup.
# Use a permanent System User token (Business Settings > System Users) with
# whatsapp_business_messaging + whatsapp_business_management permissions.
# While these are empty, WhatsApp auto-replies stay off (Messenger keeps working).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ENCRYPTION SECRET FOR TOKENS AT REST (AES-256)
# Generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_ENCRYPTION_SECRET="c2f4c8b681645de77765c07d82ce8acdebbf83c81a5d588d9760c3e5839d59d1"

# SOCIAL PUBLISHER RUNTIME MODE: 'mock' (dev simulation) or 'live' (official Meta API calls)
SOCIAL_PUBLISHER_MODE="mock"

# POSTGRESQL DATABASE CONFIGURATION
# You can use a direct connection string:
# DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/metacloser"
# Or configure individual parameters:
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="metacloser"

